# PharmaZs — docker compose configuration.
# Copy to .env in the project root and fill in real values. Never commit .env.

# ---- database -------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-root
DB_NAME=pharmazs
DB_USER=pharmazs
DB_PASSWORD=change-me-app-password

# ---- API ------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-generate-a-real-secret
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
LOG_LEVEL=info

# Comma-separated browser origins allowed to call the API. This must be the
# PUBLIC frontend origin. Getting it wrong shows up as a failed login with a
# CORS preflight error, which looks like an auth bug and is not one.
CORS_ORIGINS=http://localhost:3000

# ---- frontend (BUILD TIME — rebuild after changing) -----------------------
# The URL the browser calls, never an internal compose service name.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# ---- port publishing ------------------------------------------------------
# Default binds to loopback only, so nginx/Caddy on the host terminates TLS and
# proxies in. Set to 0.0.0.0 only if you intend to serve plain HTTP publicly.
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1
