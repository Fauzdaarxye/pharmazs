# PharmaZs backend configuration — copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000

# MySQL (isolated Homebrew instance on 3307 — NOT the system MySQL on 3306)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=pharmazs
DB_PASSWORD=pharmazs_dev_2026
DB_NAME=pharmazs
DB_SOCKET=/opt/homebrew/var/mysql/pharmazs.sock
DB_CONNECTION_LIMIT=10

# JWT / auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
BCRYPT_COST=10

# ML service (Python FastAPI) — may not be up yet
ML_BASE_URL=http://localhost:8000
ML_TIMEOUT_MS=5000

# CORS: comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

LOG_LEVEL=info
