# PharmaZs ML service — copy to .env
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=pharmazs
DB_USER=pharmazs
DB_PASSWORD=pharmazs_dev_2026
ML_HOST=127.0.0.1
ML_PORT=8000

# RAG chat (Gemini). WITHOUT this key the /chat endpoint still works: retrieval
# runs against MySQL and the answer is the raw verified context, clearly labelled
# as mock mode. Set it to get a narrated answer.
GEMINI_API_KEY=

# Optional model override. Defaults to gemini-3.6-flash. Set this when the
# default is retired — the API returns 404 naming its replacement, so no code
# change is needed.
GEMINI_MODEL=
